# phpunit.xml.dist is the tracked template and the one CI runs. A local
# phpunit.xml overrides it per-machine and is deliberately not shared, so the
# two cannot drift apart again.
phpunit.xml

# Laravel Boost writes agent tool configuration into the paths below. Which
# agent a developer runs, and which parts of Boost they install for it, is that
# developer's own setup. Keeping these out of the repository means nobody's
# configuration is committed and nobody's is overwritten by anyone else's.
.ai
.agentic-tools-mcp
.agents
.claude
.codex
.cursor
.factory
.gemini
.github/copilot-instructions.md
